{
  "expo": {
    "name": "CUHK Campus",
    "slug": "cuhk-campus",
    "scheme": "cuhkcampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ansonchow.cuhkcampus",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.ansonchow.cuhkcampus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6E2A8C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#000000" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Society committee members use the camera to scan attendees' QR tickets at the door.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your society logo, event covers and promotional banners.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Add events you sign up for to your calendar.",
          "writeOnlyCalendarPermission": "Add events you sign up for to your calendar.",
          "writeOnlyAccess": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {}
    }
  }
}
