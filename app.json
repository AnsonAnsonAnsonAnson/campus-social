{
  "expo": {
    "name": "Campus Social",
    "slug": "campus-social",
    "scheme": "campussocial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "locales": {
      "zh-Hant": "./locales/zh-Hant.json",
      "zh-HK": "./locales/zh-Hant.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.ansonchow.campussocial",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "zh-Hant",
          "zh-HK",
          "en"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.ansonchow.campussocial",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#B8F02E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#B8F02E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Campus Social uses the camera to scan QR tickets, member cards and order pickups when you help run a society. Nothing is recorded or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your profile, a society logo, event cover, banner, post or product, or a screenshot of your payment for the society treasurer.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Campus Social adds the events you sign up for to your calendar. It never reads your other events.",
          "writeOnlyCalendarPermission": "Campus Social adds the events you sign up for to your calendar. It never reads your other events.",
          "remindersPermission": false,
          "writeOnlyAccess": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#B8F02E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "735cdfc7-9462-4211-9d4a-b49494549480"
      }
    }
  }
}
